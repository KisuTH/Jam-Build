      m_PersistentCalls:
        m_Calls: []
  - speaker: me
    text: "\u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E41\u0E1F\u0E49\u0E21\u0E2A\u0E35\u0E41\u0E14\u0E07\u0E25\u0E30\u0E04\u0E23\u0E31\u0E1A?"
