--- !u!114 &1596225082
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1596225075}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef1dc64f8cd6f814ea1782c4c00abf41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speaker: Noo
    text: "\u0E19\u0E32\u0E22\u0E21\u0E32\u0E41\u0E25\u0E49\u0E27\u0E2A\u0E34\u0E19\u0E30"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: " \u0E17\u0E35\u0E48\u0E19\u0E35\u0E48\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E01\u0E27\u0E48\u0E32\u0E17\u0E35\u0E48\u0E04\u0E34\u0E14\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E2A\u0E16\u0E32\u0E19\u0E17\u0E35\u0E48\u0E19\u0E35\u0E49\u0E16\u0E39\u0E01\u0E17\u0E34\u0E49\u0E07\u0E44\u0E27\u0E49\u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23
      \u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E43\u0E0A\u0E49\u0E19\u0E32\u0E19\u0E41\u0E25\u0E49\u0E27"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: "\u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E41\u0E1F\u0E49\u0E21\u0E2A\u0E35\u0E41\u0E14\u0E07\u0E25\u0E30\u0E04\u0E23\u0E31\u0E1A?"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E19\u0E31\u0E48\u0E19\u0E41\u0E2B\u0E25\u0E30\u0E17\u0E35\u0E48\u0E09\u0E31\u0E19\u0E2D\u0E22\u0E32\u0E01\u0E43\u0E2B\u0E49\u0E19\u0E32\u0E22\u0E15\u0E23\u0E27\u0E08\u0E2A\u0E2D\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: "\u0E21\u0E35\u0E43\u0E04\u0E23\u0E25\u0E2D\u0E07\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B\u0E14\u0E39\u0E41\u0E25\u0E49\u0E27\u0E2B\u0E23\u0E37\u0E2D\u0E22\u0E31\u0E07\u0E04\u0E23\u0E31\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23\u0E2D\u0E22\u0E32\u0E01\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B\r\n"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: "\u0E40\u0E02\u0E49\u0E32\u0E43\u0E08\u0E41\u0E25\u0E49\u0E27\u0E04\u0E23\u0E31\u0E1A
      \u0E41\u0E25\u0E49\u0E27\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E2D\u0E35\u0E01\u0E44\u0E2B\u0E21\u0E04\u0E23\u0E31\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E44\u0E21\u0E48\u0E21\u0E35\u0E41\u0E25\u0E49\u0E27\u0E25\u0E30"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E43\u0E0A\u0E48 \u0E16\u0E49\u0E32\u0E04\u0E38\u0E13\u0E40\u0E08\u0E2D\u0E41\u0E1F\u0E49\u0E21\u0E2A\u0E35\u0E41\u0E14\u0E07
      \u0E43\u0E2B\u0E49\u0E23\u0E35\u0E1A\u0E40\u0E2D\u0E32\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E43\u0E2B\u0E49\u0E1C\u0E21\u0E14\u0E49\u0E27\u0E22"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: "\u0E41\u0E25\u0E49\u0E27\u0E43\u0E19\u0E41\u0E1F\u0E49\u0E21\u0E19\u0E31\u0E49\u0E19\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E04\u0E23\u0E31\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E09\u0E31\u0E19\u0E40\u0E2D\u0E07\u0E01\u0E47\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E23\u0E32\u0E22\u0E25\u0E30\u0E40\u0E2D\u0E35\u0E22\u0E14\u0E17\u0E31\u0E49\u0E07\u0E2B\u0E21\u0E14"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: "\u0E16\u0E49\u0E32\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E31\u0E49\u0E19\u0E1C\u0E21\u0E08\u0E30\u0E25\u0E2D\u0E07\u0E2B\u0E32\u0E43\u0E2B\u0E49\u0E04\u0E23\u0E31\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E41\u0E25\u0E49\u0E27\u0E01\u0E47\u0E23\u0E30\u0E27\u0E31\u0E07\u0E15\u0E31\u0E27\u0E14\u0E49\u0E27\u0E22"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: "\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E17\u0E35\u0E48\u0E1C\u0E21\u0E04\u0E27\u0E23\u0E23\u0E39\u0E49\u0E2D\u0E35\u0E01\u0E44\u0E2B\u0E21\u0E04\u0E23\u0E31\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Noo
    text: "\u0E09\u0E31\u0E19\u0E1D\u0E32\u0E01\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E35\u0E49\u0E01\u0E31\u0E1A\u0E19\u0E32\u0E22\u0E14\u0E49\u0E27\u0E22\u0E04\u0E38\u0E13\u0E19\u0E31\u0E01\u0E2A\u0E37\u0E1A\u0E14\u0E49\u0E27\u0E22"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
  - speaker: Shin
    text: "\u0E04\u0E23\u0E31\u0E1A"
    autoAdvanceAfter: 0
    speakerThai: 
    textThai: 
    onLineShown:
      m_PersistentCalls:
        m_Calls: []
