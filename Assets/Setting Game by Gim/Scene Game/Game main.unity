  m_Script: {fileID: 11500000, guid: 70b2f8e52f59b504eb75721897a014d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interactable2D
  displayName: Wound Care Instructions
  description: 'An old notice: WOUND CARE ORDER. 1. Prepare the tray. 2. Place the
    bandage. 3. Prepare the wound tools (scissors / forceps). 4. Prepare the medicine
    / disinfectant. - Public Health Officer'
  descriptionThai: "\u0E40\u0E2D\u0E01\u0E2A\u0E32\u0E23\u0E40\u0E01\u0E48\u0E32:
    \u0E04\u0E33\u0E2A\u0E31<voffset=0.22em>\u0E48</voffset>\u0E07\u0E01\u0E32\u0E23\u0E17\u0E33\u0E41\u0E1C\u0E25
    1. \u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E16\u0E32\u0E14 2. \u0E43\u0E2A\u0E48\u0E1C\u0E49\u0E32\u0E1E\u0E31\u0E19\u0E41\u0E1C\u0E25
    3. \u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C\u0E17\u0E33\u0E41\u0E1C\u0E25
    (\u0E01\u0E23\u0E23\u0E44\u0E01\u0E23 / \u0E04\u0E35\u0E21) 4. \u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E22\u0E32
    / \u0E19<cspace=0.12em>\u0E49</cspace>\u0E33\u0E22\u0E32\u0E06\u0E48\u0E32\u0E40\u0E0A\u0E37<voffset=0.22em>\u0E49</voffset>\u0E2D
    - \u0E40\u0E08\u0E49\u0E32\u0E2B\u0E19\u0E49\u0E32\u0E17\u0E35<voffset=0.22em>\u0E48</voffset>\u0E2A\u0E32\u0E18\u0E32\u0E23\u0E13\u0E2A\u0E38\u0E02"
  maxDistance: 7
  tooFarMessage: Too far away...
  requiredItemId: 
  consumeRequiredItem: 1
  missingItemMessage: I can't use this yet... I need something first.
  requiredFlags: []
  missingFlagsMessage: I still don't understand enough to do this...
